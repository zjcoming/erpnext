    },
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "options": "Company",
      "label": "Company",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "supplier",
      "fieldtype": "Link",
      "options": "Supplier",
      "label": "Supplier",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "occurred_at",
      "fieldtype": "Datetime",
      "label": "Occurred At",
      "read_only": 1,
      "in_list_view": 0
