+def lock_login_credentials():
+	"""Lock login candidates before the request establishes a consistent snapshot.
+
+	This only serializes authentication for the same indexed identity. The original
+	login flow still chooses the user, checks enabled/alias settings/password/2FA and
+	runs every hook once. No credentials are authenticated by this lock lookup.
+	"""
+	if frappe.db.db_type != "mariadb" or frappe.flags.read_only:
+		return
+	if not (
+		frappe.form_dict.get("cmd") == "login" or frappe.request.path == "/api/method/login"
+	):
+		return
+	# init_request calls us before HTTPRequest and before the first DB query. Never
+	# acquire a late lock and pretend that an existing snapshot has become fresh.
+	if (
+		frappe.db._conn is not None
+		or frappe.db.transaction_writes
+		or frappe.db._disable_transaction_control
+		or any(
+			manager._functions
+			for manager in (
+				frappe.db.before_commit,
+				frappe.db.after_commit,
+				frappe.db.before_rollback,
+				frappe.db.after_rollback,
+			)
+		)
+	):
+		return
+	user, password = get_cached_user_pass()
+	if not (user and password):
+		user = frappe.form_dict.get("usr")
+	if not isinstance(user, str) or not user or len(user) > 140:
+		return
+	# This prefix owns ONLY the identifier lookup: no HTTPRequest, authentication,
+	# document hooks, writes or transaction callbacks have run. Discard its read
+	# view before acquiring locks. An OR locking query can lock unrelated users
+	# when the optimizer chooses a table scan, so use sorted primary-key locks.
+	lookup = (
+		"SELECT `name` FROM `tabUser` "
+		"WHERE `name` = %s OR `username` = %s OR `mobile_no` = %s"
+	)
+	parameters = (user, user, user)
+	frappe.db.begin(read_only=True)
+	candidates = sorted({name for (name,) in frappe.db.sql(lookup, parameters)})
+	frappe.db.rollback()
+	for name in candidates:
+		frappe.db.sql("SELECT `name` FROM `tabUser` WHERE `name` = %s FOR UPDATE", (name,))
+	for name in candidates:
+		# Password resets must not race a login using a stale password snapshot.
+		frappe.db.sql(
+			"SELECT `name` FROM `__Auth` "
+			"WHERE `doctype` = 'User' AND `name` = %s AND `fieldname` = 'password' FOR UPDATE",
+			(name,),
+		)
