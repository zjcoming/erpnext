+	# abort before any login hook rather than authenticate an unlocked account.
+	if candidates != sorted({name for (name,) in frappe.db.sql(lookup, parameters)}):
+		raise frappe.AuthenticationError(_("Invalid login credentials. Please try again."))
 
 
