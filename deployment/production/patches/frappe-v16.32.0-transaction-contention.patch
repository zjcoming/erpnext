+def _series_current_read(query, values):
+	# A counter must use the latest committed value, even when the document's
+	# business reads use an older snapshot. This is one statement, on the SAME
+	# connection/transaction: its row lock, increments and decrements still roll
+	# back with the document. MariaDB restores the setting even on SQL errors.
+	return frappe.db.sql("SET STATEMENT innodb_snapshot_isolation=OFF FOR " + query, values)
