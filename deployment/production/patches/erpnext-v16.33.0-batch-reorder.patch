+def _usable_batch_stock_for_reorder(item_code):
+	"""Physical lots only: no SRE/POS deduction, since this adjusts Bin projection."""
+	from erpnext.stock.doctype.batch.batch import get_batch_qty
+
+	# Stock-level mode retains expired lots and bypasses pending POS deductions.
+	# Apply validity here so only unusable physical stock is removed from Bin.
+	batches = get_batch_qty(
+		item_code=item_code,
+		for_stock_levels=True,
+		ignore_reserved_stock=True,
+		consider_negative_batches=True,
+	)
+	disabled = set(frappe.get_all("Batch", filters={"item": item_code, "disabled": 1}, pluck="name"))
+	qty_by_warehouse = {}
+	today = getdate(nowdate())
+	for batch in batches:
+		if batch.batch_no in disabled or (batch.expiry_date and getdate(batch.expiry_date) < today):
+			continue
+		qty_by_warehouse[batch.warehouse] = qty_by_warehouse.get(batch.warehouse, 0) + flt(batch.qty)
+	return qty_by_warehouse
