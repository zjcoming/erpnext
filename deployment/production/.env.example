ERP_IMAGE=hengsuan/erpnext:v16.33.0-hs.20260909.1
PULL_POLICY=never
SITE_NAME=erp.hengsuankeji.com
FRONTEND_BIND=127.0.0.1:8080
DB_ROOT_PASSWORD_FILE=./secrets/db_root_password.txt
ADMIN_PASSWORD_FILE=./secrets/admin_password.txt
# Current 4C8G production baseline; see web-concurrency.md.
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=2000
GUNICORN_MAX_REQUESTS_JITTER=200
CLIENT_MAX_BODY_SIZE=100m
PROXY_READ_TIMEOUT=180
